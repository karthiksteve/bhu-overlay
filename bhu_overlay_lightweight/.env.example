# =============================================================================
# Bhu-Overlay -- Configuration Template (.env.example)
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env:
#      PowerShell: Copy-Item .env.example .env
#      Bash:       cp .env.example .env
#   2. Fill in your Gemini API key if you want AI advisory recommendations.
#   3. Note: The application runs 100% offline with deterministic subdivision
#      algorithms if no GEMINI_API_KEY is provided.
# =============================================================================

# --- Server Settings ---
PORT=5001
FLASK_DEBUG=0

# --- State & Government GIS Service URLs ---
STATE_CODE=10
STATE_NAME=Bihar
BHUNAKSHA_URL=https://bhunaksha.bihar.gov.in
GIS_URL=https://gisserver.bihar.gov.in/arcgis/rest/services
VERIFY_SSL=0

# --- Optional AI Advisory Settings (Google Gemini) ---
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
